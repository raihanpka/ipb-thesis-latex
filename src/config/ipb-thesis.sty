\newcommand{\ipbgraphicplaceholder}[2][0.8\textwidth]{%
  \fbox{\parbox[c][4cm][c]{#1}{\centering #2}}%
}

% Judul bagian awal tanpa perilaku page break bawaan \chapter*.
\newcommand{\ipbprelimheading}[1]{%
  \thispagestyle{empty}%
  {\centering\fontsize{14pt}{17pt}\selectfont\bfseries
   \MakeUppercase{#1}\par}%
  \vspace{12pt}%
}

% Judul kedua pada halaman awal, misalnya ABSTRACT dan HIGHLIGHTS.
\newcommand{\ipbprelimsubheading}[1]{%
  \par\vspace{12pt}%
  {\centering\fontsize{14pt}{17pt}\selectfont\bfseries #1\par}%
  \vspace{12pt}%
}

